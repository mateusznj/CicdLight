<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CicdLight" Manufacturer="CicdLight" Version="$(Version)"
		   UpgradeCode="6B1F3C52-4D8E-4A7B-9E21-5C0A8D7F3B14" Scope="perMachine">
	<MajorUpgrade DowngradeErrorMessage="A newer version of CicdLight is already installed." />
	<MediaTemplate EmbedCab="yes" />
	<Icon Id="AppIcon.ico" SourceFile="$(IconPath)" />
	<Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

	<StandardDirectory Id="ProgramFiles64Folder">
	  <Directory Id="INSTALLFOLDER" Name="CicdLight" />
	</StandardDirectory>

	<Files Include="$(PublishDir)\**" />

	<StandardDirectory Id="ProgramMenuFolder">
	  <Component Id="StartMenuShortcut" Guid="3E9A5B70-8C14-4F6D-A2B3-71D4E0C9F582">
		<Shortcut Id="AppShortcut" Name="CicdLight" Target="[INSTALLFOLDER]CicdLight.exe"
				  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
		<RegistryValue Root="HKCU" Key="Software\CicdLight" Name="ShortcutInstalled"
					   Type="integer" Value="1" KeyPath="yes" />
	  </Component>
	</StandardDirectory>

	<CustomAction Id="LaunchApp" Directory="INSTALLFOLDER"
				  ExeCommand="&quot;[INSTALLFOLDER]CicdLight.exe&quot;" Return="asyncNoWait" />
	<InstallExecuteSequence>
	  <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed" />
	</InstallExecuteSequence>
  </Package>
</Wix>
